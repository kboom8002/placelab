{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "response_record.schema.json",
  "title": "응답 원문",
  "description": "조회로 받은 응답 전량. 요약해 저장하지 않는다. 요약 필드가 없는 것이 의도된 설계",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "response_id",
    "question_id",
    "agency_handle",
    "run_profile_id",
    "attempt",
    "observed_at",
    "outcome",
    "raw_text"
  ],
  "properties": {
    "response_id": {
      "type": "string",
      "minLength": 1
    },
    "question_id": {
      "type": "string",
      "minLength": 1
    },
    "agency_handle": {
      "type": "string",
      "minLength": 1,
      "description": "실명 문자열을 넣지 않는다. 공표 경로에서 치환할 수 있어야 한다"
    },
    "run_profile_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "description": "회차. 회차별 응답을 모두 보존한다. 대표값 하나만 남기지 않는다"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "outcome": {
      "enum": [
        "answered",
        "refused",
        "error"
      ],
      "description": "refused 는 결측이 아니라 관측값(N5)이다"
    },
    "raw_text": {
      "type": "string",
      "description": "원문 전량. 빈 문자열은 거절·오류인 경우에만 허용"
    },
    "body_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "응답 본문 안의 주소. 근거 목록과 합산하지 않는다"
    },
    "citation_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "응답이 별도로 제시한 근거 목록. 본문 주소와 합산하지 않는다"
    },
    "error_detail": {
      "type": "string"
    },
    "lang": {
      "enum": ["ko", "en"],
      "description": "질의 언어. 영어 문항은 한국어 문항의 번역이며 같은 원장을 쓴다 (ADR-0012 D-6)"
    },
    "model_returned": {
      "type": "string",
      "description": "API 가 반환한 모델 문자열 그대로. 측정 창 중 바뀌면 중단 규칙 대상 (ADR-0012 D-5)"
    },
    "search_condition_label": {
      "enum": ["on_verified", "off", "unverified"],
      "description": "검색 조건 라벨. 신규 관측에 단독 'on' 을 쓰지 않는다 (ADR-0012 D-2)"
    },
    "search_enabled": {
      "type": "boolean",
      "description": "검색 도구를 전달했는가 (조건)"
    },
    "search_triggered": {
      "type": "boolean",
      "description": "web_search_call 이 1회 이상 있었는가 (관측). search_enabled 와 합치지 않는다"
    },
    "search_calls": {
      "type": "array",
      "description": "회차 중 발생한 검색 호출. 질의와 열람 출처. citation_urls 와 합산하지 않는다",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["query"],
        "properties": {
          "query": { "type": "string" },
          "sources": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "search_call_count": { "type": "integer", "minimum": 0 }
      }
    },
    "latency_ms": {
      "type": "integer",
      "minimum": 0
    },
    "retries": {
      "type": "array",
      "description": "재시도 전량. 실패를 조용히 재시도해 성공만 남기지 않는다 (spec/03 §2.1)",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["at", "error"],
        "properties": {
          "at": { "type": "string", "format": "date-time" },
          "error": { "type": "string" }
        }
      }
    },
    "raw_hash": {
      "type": "string",
      "description": "raw_text 의 SHA-256 (hex). 분쟁 시 재현성"
    }
  }
}
