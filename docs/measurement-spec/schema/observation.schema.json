{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "observation.schema.json",
  "title": "관측",
  "description": "한 기관의 한 문항에 대한 관측 묶음. 추출까지만 담고 판정은 담지 않는다",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observation_id",
    "question_id",
    "agency_handle",
    "run_profile_id",
    "observed_window",
    "response_ids",
    "extracted",
    "extracted_by"
  ],
  "properties": {
    "observation_id": {
      "type": "string",
      "minLength": 1
    },
    "question_id": {
      "type": "string",
      "minLength": 1
    },
    "agency_handle": {
      "type": "string",
      "minLength": 1
    },
    "run_profile_id": {
      "type": "string",
      "minLength": 1
    },
    "observed_window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "response_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "description": "이 관측을 이루는 회차별 응답. 전부 나열한다"
    },
    "extracted": {
      "type": "object",
      "additionalProperties": false,
      "description": "원문에서 꺼낸 것. 맞는지 틀린지는 여기서 정하지 않는다",
      "properties": {
        "stated_value": {
          "type": [
            "string",
            "null"
          ]
        },
        "stated_value_nature": {
          "enum": [
            "measured",
            "estimated",
            "planned",
            "unstated"
          ]
        },
        "body_url_count": {
          "type": "integer",
          "minimum": 0
        },
        "citation_url_count": {
          "type": "integer",
          "minimum": 0
        },
        "public_source_present": {
          "type": "boolean"
        },
        "named_entities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "extracted_by": {
      "enum": [
        "model",
        "rule",
        "human"
      ],
      "description": "추출에는 언어 모형을 쓸 수 있다"
    },
    "unstable": {
      "type": "boolean",
      "description": "회차 사이에 답이 갈린 경우 true. 확정 판정으로 내보내지 않는다"
    },
    "access_state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "robots_checked": {
          "type": "boolean",
          "description": "확인하지 않은 수집은 무효다"
        },
        "robots_allows": {
          "type": "boolean"
        },
        "canonical_page_found": {
          "type": "boolean"
        }
      }
    },
    "note": {
      "type": "string"
    }
  }
}
