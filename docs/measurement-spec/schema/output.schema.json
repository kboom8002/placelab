{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "output.schema.json",
  "title": "산출물",
  "description": "밖으로 나가는 단위. total·score·rank·grade·weight·empty_count 필드가 없는 것이 의도된 설계",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "output_id",
    "channel",
    "proxy_notice",
    "run_profile_id",
    "observed_at",
    "ledger_as_of",
    "sections"
  ],
  "properties": {
    "output_id": {
      "type": "string",
      "minLength": 1
    },
    "channel": {
      "enum": [
        "national_report",
        "agency_notice",
        "anonymized_dataset"
      ],
      "description": "경로마다 담기는 것이 다르다. 세 경로를 합쳐 순위를 복원할 수 있어서는 안 된다"
    },
    "proxy_notice": {
      "type": "string",
      "minLength": 1,
      "description": "조회 응답은 사용자가 보는 답과 같지 않다는 선언. 비울 수 없다"
    },
    "run_profile_id": {
      "type": "string",
      "minLength": 1
    },
    "observed_at": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "ledger_as_of": {
      "type": "string",
      "format": "date"
    },
    "notified_at": {
      "type": "string",
      "format": "date-time",
      "description": "사전 통지 시각. 전국 공표문에는 필수"
    },
    "review_closed_at": {
      "type": "string",
      "format": "date-time",
      "description": "확인 기간 종료 시각. 전국 공표문에는 필수"
    },
    "band": {
      "type": "string",
      "description": "동류 집단 안에서의 구간. 경계값은 이 저장소에 적지 않는다"
    },
    "band_of": {
      "type": "string",
      "description": "어느 동류 집단 기준인지"
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/section"
      },
      "description": "순서를 바꾸지 않는다. spec/05 §1"
    },
    "note": {
      "type": "string"
    }
  },
  "$defs": {
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order",
        "kind"
      ],
      "properties": {
        "order": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "kind": {
          "enum": [
            "canon_absence_and_ownership",
            "entity_existence",
            "nonresponse_distribution",
            "public_source_citation",
            "residual_spread"
          ]
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "channel": {
            "const": "national_report"
          }
        },
        "required": [
          "channel"
        ]
      },
      "then": {
        "required": [
          "notified_at",
          "review_closed_at"
        ]
      },
      "$comment": "사전 통지와 확인 기간을 거치지 않은 결과를 공표하지 않는다"
    }
  ]
}
